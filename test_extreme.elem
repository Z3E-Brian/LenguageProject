emitln("14. BUCLE CON TODAS LAS OPERACIONES MATEMÁTICAS");

chain 1 to 5 {
    atom suma_op : atom_num = loop_1 + 10;
    atom resta_op : atom_num = loop_1 - 1;
    atom mult_op : atom_num = loop_1 * 3;
    
    emitln("loop_1=", loop_1, ": +10=", suma_op, ", -1=", resta_op, ", *3=", mult_op);
}

