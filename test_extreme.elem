emitln("");

!! ============================================
!! 9. CONDICIONES COMPLEJAS CON MÚLTIPLES ELIF
!! ============================================
emitln("9. MÚLTIPLES CONDICIONES (IF-ELIF-ELSE)");

reaction clasificar_numero(num: atom_num) : formula {
    itest (num < 0) {
        release "Negativo";
    } inotest (num == 0) {
        release "Cero";
    } inotest (num <= 10) {
        release "Pequeño (1-10)";
    } inotest (num <= 50) {
        release "Mediano (11-50)";
    } inotest (num <= 100) {
        release "Grande (51-100)";
    } notest {
        release "Muy grande (>100)";
    }
}

atom clase1 : formula = clasificar_numero(-5);
emitln("clasificar_numero(-5) = ", clase1);

atom clase2 : formula = clasificar_numero(0);
emitln("clasificar_numero(0) = ", clase2);

atom clase3 : formula = clasificar_numero(7);
emitln("clasificar_numero(7) = ", clase3);

atom clase4 : formula = clasificar_numero(25);
emitln("clasificar_numero(25) = ", clase4);

atom clase5 : formula = clasificar_numero(75);
emitln("clasificar_numero(75) = ", clase5);

atom clase6 : formula = clasificar_numero(200);
emitln("clasificar_numero(200) = ", clase6);

emitln("");

