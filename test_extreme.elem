emitln("15. FUNCIONES CON DIFERENTES TIPOS DE RETORNO");

reaction funcion_numero() : atom_num {
    release 42;
}

reaction funcion_texto() : formula {
    release "Texto de prueba";
}

reaction funcion_boolean() : polarized {
    release pos;
}

reaction funcion_void() : void_state {
    emitln("  Función void ejecutada");
}

atom fn1 : atom_num = funcion_numero();
atom fn2 : formula = funcion_texto();
atom fn3 : polarized = funcion_boolean();
funcion_void();

emitln("Retornos: ", fn1, ", ", fn2);

emitln("");

!! ============================================
!! 16. ANIDAMIENTO EXTREMO: 3 NIVELES DE BUCLES
!! ============================================
emitln("16. ANIDAMIENTO DE 3 NIVELES DE BUCLES");

atom triple_sum : atom_num = 0;

chain 1 to 2 {
    emitln("Nivel 1: loop_1=", loop_1);
    
    chain 1 to 2 {
        emitln("  Nivel 2: loop_2=", loop_2);
        
        chain 1 to 2 {
            emitln("    Nivel 3: loop_3=", loop_3);
            triple_sum = triple_sum + (loop_1 + loop_2 + loop_3);
        }
    }
}

emitln("Suma triple anidada: ", triple_sum);
emitln("");

!! ============================================
!! 17. ESTRÉS TEST: BUCLE GRANDE
!! ============================================
emitln("17. STRESS TEST: BUCLE DE 100 ITERACIONES");

atom stress_count : atom_num = 0;
atom stress_sum : atom_num = 0;

chain 1 to 100 {
    stress_count = stress_count + 1;
    stress_sum = stress_sum + loop_1;
}

emitln("Conteo: ", stress_count);
emitln("Suma 1-100: ", stress_sum, " (esperado: 5050)");

emitln("");

!! ============================================
!! 18. COMPARACIONES EXTREMAS
!! ============================================
emitln("18. COMPARACIONES EXTREMAS");

atom num1 : atom_num = 100;
atom num2 : atom_num = 100;
atom num3 : atom_num = 99;

itest (num1 == num2) {
    emitln("100 == 100 si");
}

itest (num1 != num3) {
    emitln("100 != 99 si");
}

itest (num1 > num3) {
    emitln("100 > 99 si");
}

itest (num1 >= num2) {
    emitln("100 >= 100 si");
}

itest (num3 < num1) {
    emitln("99 < 100 si");
}

itest (num3 <= num1) {
    emitln("99 <= 100 si");
}

emitln("");

