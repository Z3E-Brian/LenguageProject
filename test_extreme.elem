!! ============================================
!! 12. FUNCIONES CON BOOLEANS COMPLEJOS
!! ============================================
emitln("12. FUNCIONES CON LÓGICA BOOLEANA");

reaction es_primo_simple(n: atom_num) : polarized {
    itest (n <= 1) {
        release neg;
    }
    
    itest (n == 2) {
        release pos;
    }
    
    itest (n % 2 == 0) {
        release neg;
    }
    
    !! Verificar divisores impares hasta 9
    itest (n % 3 == 0) {
        itest (n == 3) {
            release pos;
        } notest {
            release neg;
        }
    }
    
    itest (n % 5 == 0) {
        itest (n == 5) {
            release pos;
        } notest {
            release neg;
        }
    }
    
    itest (n % 7 == 0) {
        itest (n == 7) {
            release pos;
        } notest {
            release neg;
        }
    }
    
    release pos;
}

atom primo2 : polarized = es_primo_simple(2);
atom primo3 : polarized = es_primo_simple(3);
atom primo4 : polarized = es_primo_simple(4);
atom primo5 : polarized = es_primo_simple(5);
atom primo7 : polarized = es_primo_simple(7);
atom primo9 : polarized = es_primo_simple(9);

itest (primo2) {
    emitln("2 es primo si");
}

itest (primo3) {
    emitln("3 es primo si");
}

itest (primo4) {
    emitln("4 es primo (ERROR!)");
} notest {
    emitln("4 NO es primo si");
}

itest (primo5) {
    emitln("5 es primo si");
}

itest (primo7) {
    emitln("7 es primo si");
}

itest (primo9) {
    emitln("9 es primo (ERROR!)");
} notest {
    emitln("9 NO es primo si");
}

emitln("");

!! ============================================
!! 13. CONSTANTES Y VARIABLES MEZCLADAS
!! ============================================
emitln("13. CONSTANTES Y VARIABLES");

ion CONSTANTE_MAX : atom_num = 100;
ion CONSTANTE_MIN : atom_num = 0;
ion CONSTANTE_PI : mass = 3.14159;

atom variable_dinamica : atom_num = 50;

itest (variable_dinamica > CONSTANTE_MIN) {
    itest (variable_dinamica < CONSTANTE_MAX) {
        emitln("variable_dinamica está en rango [0, 100] si");
    }
}

emitln("");

